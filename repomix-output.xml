                                                    Icons.edit_outlined,
                                                    color: Colors.teal.shade600,
                                                    size: 18,
                                                  ),
                                                ),
                                                const SizedBox(width: 12),
                                                InkWell(
                                                  onTap: () => _deleteSchedule(
                                                      schedule.id),
                                                  child: Icon(
                                                    Icons.close,
                                                    color: Colors.red.shade400,
                                                    size: 18,
                                                  ),
                                                ),
                                              ],
                                            ),
                                          );
                                        })
                                        .toList(),
                              ),
                            ),
                          ],
                        ),
                      ),
                    ),
                  );
                }).toList(),
