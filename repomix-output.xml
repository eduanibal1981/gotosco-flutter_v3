    test('should generate consistent ID regardless of user order', () {
      final id1 = 'user_123';
      final id2 = 'user_456';

      final result1 = getConversationId(id1, id2);
      final result2 = getConversationId(id2, id1);

      // user_123 < user_456
      expect(result1, 'user_123_user_456');
