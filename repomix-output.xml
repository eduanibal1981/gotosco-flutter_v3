                        padding: const EdgeInsets.all(16),
                        child: Row(
                          children: [
                            // Checkbox
                            Container(
                              width: 24,
                              height: 24,
                              decoration: BoxDecoration(
                                color: isForParent
                                    ? Colors.indigo.shade600
                                    : Colors.transparent,
                                border: Border.all(
