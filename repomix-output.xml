import 'package:test/test.dart';

// Copy of the logic from ChatRepository for isolated testing
String getConversationId(String id1, String id2) {
  return id1.compareTo(id2) < 0 ? '${id1}_$id2' : '${id2}_$id1';
}

void main() {
